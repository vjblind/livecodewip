await initHydra()

function loadScript(src) {
  return new Promise((resolve, reject) => {
    if (document.querySelector('script[src="' + src + '"]')) { resolve(); return; }
    var s = document.createElement('script');
    s.src = src; s.onload = resolve; s.onerror = reject;
    document.head.appendChild(s);
  });
}
if (!window.p5) await loadScript('https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js')

if (window._p5smile) window._p5smile.remove()
if (window._p5flash) window._p5flash.remove()
if (window._p5text)  window._p5text.remove()
if (window._label)   window._label.remove()
if (window._fxLoop)  clearInterval(window._fxLoop)

// ===== RYTHME PARTAGÉ : son + visuels =====
const K = "1 0 1 0 1 0 1 0"   // kick on the beat
const B = "0 1 0 1 0 1 0 1"   // kick off-beat
const S = "0 0 1 0 0 0 1 0"   // snare
const kP = H(K)
const bP = H(B)
const sP = H(S)

const PAL_K = [[0, 195, 255], [255, 0, 128], [0, 255, 180]]
const PAL_B = [[255, 200, 0], [255, 90, 0]]
const PAL_S = [[255, 255, 255]]

// ===== INSTRUMENTS =====
const kick  = s("bd").struct(K)
const kickB = s("bd:3").struct(B).gain(.7).lpf(1200)
const snare = s("sd:0").struct(S)
const roll  = s("sd:0*8").gain(saw.range(.2, 1).slow(8))
const hats  = s("hh*8").gain(.04)
const open  = s("~ oh ~ oh ~ oh ~ oh").gain(.35)
const pad   = note("<c3 eb3 g3 bb3>").s("supersaw").lpf(1200).gain(.35).slow(2).room(.6)
const line  = note("c1 ~ c1 eb1 ~ c1 g1 ~").s("sawtooth").gain(.8)

// ===== SECTIONS = stacks =====
const sections = {
  intro: stack(hats, pad, line.lpf(250)),
  build: stack(kick, roll, hats, line.lpf(sine.range(250, 1500).slow(8))),
  drop:  stack(kick, kickB, snare, hats, open, line.lpf(900).lpq(6).distort(.3)),
  break: stack(pad, line.lpf(250)),
  outro: stack(kick, hats, pad)
}

// ===== PLAN : une seule source pour le son ET le texte =====
const plan = [
  [8,  'intro'],
  [8,  'build'],
  [16, 'drop'],
  [8,  'break'],
  [16, 'drop'],
  [8,  'outro']
]
const labelP = H(arrange(...plan.map(([n, name]) => [n, pure(name)])))

// ===== 10 FONDS (change les liens toi-même) =====
const BG = 'https://media2.giphy.com/media/v1.Y2lkPTc5MGI3NjExaGt0bm9xMHN4eTg5aTFqODBqaGZ6M2llY3BwcmxybXloMjdyeHN2OSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/fw3aNWFd70uafr7EMB/giphy.gif'
const BG1 =  'https://media4.giphy.com/media/v1.Y2lkPTc5MGI3NjExaHk5ZmtxN3hzeTY0OW4wc2xtZWVpcmtwZjY4YnJ5eW50cnE0cDQxZSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/WsF32JfAJyyUjUTTy2/giphy.gif'
const BG2 =  'https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdHc1aTJjZHJzM2wwZHZkYXB0bzljbjNxaGNpOXM3OHZvZm5oMXI3YSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/TtFIMantyMKeA/giphy.gif'
const BG3 =  'https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdHc1aTJjZHJzM2wwZHZkYXB0bzljbjNxaGNpOXM3OHZvZm5oMXI3YSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/TtFIMantyMKeA/giphy.gif'

const BACKGROUNDS = [
  BG1, // 0
  BG1, // 1
  BG2, // 2
  BG3, // 3
  BG,  // 4
  BG,  // 5
  BG,  // 6
  BG,  // 7
