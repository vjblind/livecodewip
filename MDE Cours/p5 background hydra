await initHydra()

function loadScript(src) {
  return new Promise((ok, ko) => {
    const s = document.createElement('script')
    s.src = src; s.onload = ok; s.onerror = ko
    document.head.appendChild(s)
  })
}
if (!window.p5) await loadScript('https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js')

if (window._p5smile) window._p5smile.remove()
if (window._label) window._label.remove()   // nettoie l'ancien div HTML
if (window._fxLoop) clearInterval(window._fxLoop)

// ===== RYTHME (le smiley pulse sur ça) =====
const K = "1 0 1 0 1 0 1 0"
const S = "0 0 1 0 0 0 1 0"
const kP = H(K)
const sP = H(S)

// ===== INSTRUMENTS =====
const kick  = s("bd").struct(K)
const snare = s("sd:0").struct(S)
const roll  = s("sd:0*8").gain(saw.range(.2, 1).slow(8))
const hats  = s("hh*8").gain(.04)
const open  = s("~ oh ~ oh ~ oh ~ oh").gain(.35)
const pad   = note("<c3 eb3 g3 bb3>").s("supersaw").lpf(1200).gain(.35).slow(2).room(.6)
const line  = note("c1 ~ c1 eb1 ~ c1 g1 ~").s("sawtooth").gain(.8)

// ===== SECTIONS = stacks =====
const sections = {
  intro: stack(hats, pad, line.lpf(250)),
  build: stack(kick, roll, hats, line.lpf(sine.range(250, 1500).slow(8))),
  drop:  stack(kick, snare, hats, open, line.lpf(900).lpq(6).distort(.3)),
  break: stack(pad, line.lpf(250)),
  outro: stack(kick, hats, pad)
}

// ===== PLAN : une seule source pour le son ET le texte =====
const plan = [
  [8,  'intro'],
  [8,  'build'],
  [16, 'drop'],
  [8,  'break'],
  [16, 'drop'],
  [8,  'outro']
]
const labelP = H(arrange(...plan.map(([n, name]) => [n, pure(name)])))

// ===== 10 FONDS (change les liens toi-même) =====
const BG = 'https://media2.giphy.com/media/v1.Y2lkPTc5MGI3NjExaGt0bm9xMHN4eTg5aTFqODBqaGZ6M2llY3BwcmxybXloMjdyeHN2OSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/fw3aNWFd70uafr7EMB/giphy.gif'
const BG1 =  'https://media4.giphy.com/media/v1.Y2lkPTc5MGI3NjExaHk5ZmtxN3hzeTY0OW4wc2xtZWVpcmtwZjY4YnJ5eW50cnE0cDQxZSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/WsF32JfAJyyUjUTTy2/giphy.gif'
const BG2 =  'https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdHc1aTJjZHJzM2wwZHZkYXB0bzljbjNxaGNpOXM3OHZvZm5oMXI3YSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/TtFIMantyMKeA/giphy.gif'
const BG3 =  'https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExdHc1aTJjZHJzM2wwZHZkYXB0bzljbjNxaGNpOXM3OHZvZm5oMXI3YSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/TtFIMantyMKeA/giphy.gif'

const BACKGROUNDS = [
  BG1, // 0
  BG1, // 1
  BG2, // 2
  BG3, // 3
  BG,  // 4
  BG,  // 5
  BG,  // 6
  BG,  // 7
  BG,  // 8
  BG   // 9
]

// ===== PLAN DES FONDS : [cycles, index dans BACKGROUNDS] =====
const bgPlan = [
  [8,  0],
  [8,  1],
  [16, 2],
  [8,  3],
  [16, 4],
  [8,  5]
]
const bgP = H(arrange(...bgPlan.map(([n, i]) => [n, pure(i)])))

// ===== 5 EFFETS HYDRA (duplique / commente / modifie) =====
const FX = [
  // 0 : propre, sans effet
  () => src(s0).out(o0),

  // 1 : kaleid + feedback
  () => src(o0).kaleid(2).scale(1.004).blend(src(s0), .5).out(o0),

  // 2 : couleurs qui tournent
  () => src(s0).hue(() => time * .1).saturate(2).contrast(1.2).out(o0),

  // 3 : pixel + distorsion bruit
  () => src(s0).pixelate(60, 40).modulate(noise(3, .1), .02).out(o0),

  // 4 : modulation osc + feedback rotatif
  () => src(s0).modulateScale(osc(6, .1), -.3)
          .blend(src(o0).scale(1.01).rotate(.01), .3).out(o0)
]

// ===== PLAN DES EFFETS : [cycles, index dans FX] =====
const fxPlan = [
  [8,  0],
  [8,  1],
  [16, 2],
  [8,  3],
  [16, 4],
  [8,  0]
]
const fxP = H(arrange(...fxPlan.map(([n, i]) => [n, pure(i)])))

// ===== IMAGE (smiley, mise en cache) =====
if (!window._smileUrl) {
  const api = 'https://commons.wikimedia.org/w/api.php?action=query&format=json&origin=*'
    + '&prop=imageinfo&iiprop=url&iiurlwidth=256&titles=File:Smiley.svg'
  const j = await (await fetch(api)).json()
  window._smileUrl = Object.values(j.query.pages)[0].imageinfo[0].thumburl
}
const IMG_URL = window._smileUrl

// ===== SKETCH =====
window._p5smile = new p5((p) => {
  let img
  let bgs = []
  let size = 100
  let wasHit = false

  p.setup = () => {
    p.createCanvas(800, 600)
    p.imageMode(p.CENTER)
    p.textAlign(p.CENTER, p.CENTER)
    p.textStyle(p.BOLD)
    p.textSize(96)
    p.background(200, 10, 100)

    window._imgCache = window._imgCache || {}
    const load = (u, cb) => window._imgCache[u] || (window._imgCache[u] = p.loadImage(u, cb))
    img = load(IMG_URL)
    bgs = BACKGROUNDS.map(u => load(u, g => g.play && g.play()))

    s0.init({ src: p.canvas, dynamic: true })
  }

  p.draw = () => {
    const idx = Number(bgP()) || 0
    const bg = bgs[idx % bgs.length]
    if (bg && bg.width > 1) {
      p.image(bg, p.width / 2, p.height / 2, p.width, p.height)
    } else {
      p.background(200, 10, 100, 40)
    }

    const hit = kP() || sP()
    if (hit && !wasHit) size = 140
    wasHit = hit
    size = p.lerp(size, 100, 0.1)

    const x = p.map(p.winMouseX, 0, p.windowWidth, 0, p.width)
    const y = p.map(p.winMouseY, 0, p.windowHeight, 0, p.height)
    p.image(img, x, y, size, size)

    // texte FIXE au centre, par-dessus le smiley
    p.fill(255)
    p.stroke(0)
    p.strokeWeight(6)
    p.text(String(labelP() || '').toUpperCase(), p.width / 2, p.height / 2)
    p.noStroke()
  }
})

// ===== HYDRA : change d'effet selon fxPlan =====
let lastFx = -1
FX[0]()
window._fxLoop = setInterval(() => {
  const i = (Number(fxP()) || 0) % FX.length
  if (i !== lastFx) { lastFx = i; FX[i]() }
}, 50)

// ===== SON =====
setcps(135/60/4)

$: arrange(...plan.map(([n, name]) => [n, sections[name]]))
